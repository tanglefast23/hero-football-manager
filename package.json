{
  "name": "hero-football-manager",
  "version": "1.0.0",
  "main": "index",
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.7",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo-google-fonts/silkscreen": "^0.4.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.3",
    "jest": "~29.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "phone": "sh scripts/phone-dev-server.sh",
    "export:web": "expo export --platform web && node scripts/web/fix-worker-bundles.mjs",
    "release:check": "node scripts/release/check-config.mjs",
    "build:fonts": "node scripts/fonts/generate-vi-marks.mjs && node scripts/fonts/build-vietnamese-face.mjs",
    "qa:ipad": "node scripts/qa/ipad-pwa-audit.mjs",
    "postinstall": "setup-skia-web",
    "format": "prettier --write \"App.tsx\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"App.tsx\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "test": "jest",
    "test:probe": "jest --runInBand --testPathIgnorePatterns='^$' --runTestsByPath"
  },
  "private": true
}
