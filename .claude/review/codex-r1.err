    36	  /** The schema the file declared, i.e. before the migration ladder ran. */
    37	  readonly gameSchemaVersion: number;
    38	  /**
    39	   * The engine version the file declared. A career is not a replay: it stores
    40	   * outcomes, not the RNG stream that produced them, so an engine change cannot
    41	   * invalidate it. Surfaced for diagnostics, never a reason to refuse.
    42	   */
    43	  readonly engineVersion: string;
    44	}
    45	
    46	/** The file-system half of an export, injected so persistence keeps no Expo import. */
    47	export interface CareerSaveExportOptions {
    48	  /** The career to write out; the live in-memory state, not the stored row. */
    49	  state: GameState;
    50	  /** Writes UTF-8 text under `fileName` and returns a locator for it (a URI). */
    51	  writeFile: (fileName: string, contents: string) => Promise<string>;
    52	  /** Hands the written file to the user — share sheet on iOS, download on web. */
    53	  shareFile?: (uri: string) => Promise<void>;
    54	}
    55	
    56	export interface CareerSaveExportResult {
    57	  readonly fileName: string;
