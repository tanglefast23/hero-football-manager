  2374	  const sponsorMonthlyFee = schema3UserSponsorMonthlyFee(state);
  2375	  const capacity = highestDivision === undefined
  2376	    ? 0
  2377	    : managedSponsorCapacity(highestDivision);
  2378	  const activeContracts = capacity === 0
  2379	    ? []
  2380	    : createProvisionalSponsorPortfolio(sponsorMonthlyFee, capacity, season);
  2381	
  2382	  return {
  2383	    ...state,
  2384	    facilities: migrateSchema3Facilities(state.facilities),
  2385	    clubBusiness: {
  2745	function isDivisionLevel(value: unknown): value is 1 | 2 | 3 | 4 | 5 {
  2746	  return value === 1 || value === 2 || value === 3 || value === 4 || value === 5;
  2747	}
  2748	
  2749	function hasOwn(value: object, key: PropertyKey): boolean {
  2750	  return Object.prototype.hasOwnProperty.call(value, key);
  2751	}
  2752	
  2753	/**
  2754	 * The save-upgrade ladder, ordered by ascending `to`.
  2755	 *
  2756	 * Schema 2 deliberately has no schema-1 rung: the honest division ladder
  2757	 * changes every persisted rival. Development policy permits the break, while
  2758	 * refusing here prevents a half-old/half-new pyramid from loading silently.
  2759	 *
  2760	 * To add a version: raise `GAME_SCHEMA_VERSION` in `src/game/types.ts` and append
  2761	 * `{ to: <new version>, up }` here. Anything the new schema requires must be
  2762	 * synthesised by `up`, because an old save will not carry it.
  2763	 */
  2764	const GAME_STATE_MIGRATIONS: readonly GameStateMigration[] = [
  2765	  {
  2766	    to: 3,
  2767	    // Player requests added `loyalty`, `awayWeeks` and `playerRequests`, and
  2768	    // every one of them is optional — loyalty is derived from the career seed
  2769	    // whenever the field is absent (`src/game/loyalty.ts`), and the request
  2770	    // state is defaulted during reconciliation. A schema-2 save is therefore
  2771	    // already a valid schema-3 save and needs nothing synthesised.
  2772	    //
  2773	    // The rung still has to exist: the ladder refuses a missing boundary
  2774	    // outright, so without it every save written before this feature would fail
  2775	    // to load rather than upgrade.
  2776	    up: state => state,
  2777	  },
  2778	  {
  2779	    to: 4,
  2780	    up: migrateSchema3To4,
  2781	  },
  2782	  {
  2783	    to: 5,
  2784	    up: migrateSchema4To5,
  2785	  },
  2786	];
  2787	
  2788	function readSchemaVersion(value: unknown, stored: boolean): number {
  2789	  if (!isRecord(value) || !Number.isSafeInteger(value.schemaVersion)) {
  2790	    if (stored)
  2791	      throw new CorruptCareerSaveError('schemaVersion is missing or invalid');
  2792	    throw new InvalidGameStateError('schemaVersion is missing or invalid');
  2793	  }
  2794	  return value.schemaVersion as number;
  2795	}
  2796	
  2797	/**
  2798	 * Walks a stored save up to `GAME_SCHEMA_VERSION`, one boundary at a time.
  2799	 *
  2800	 * A version newer than this build is refused outright: that is a downgrade, and
  2801	 * nothing here can invent the meaning of a field written by a future version. A
  2802	 * missing rung is refused for the same reason — silently accepting it would hand
  2803	 * a half-upgraded save to the validator and report a corrupt save instead of the
  2804	 * real cause.
  2805	 */
  2806	export function migrateStoredGameState(value: unknown): unknown {
  2807	  let current = value;
  2808	  let version = readSchemaVersion(current, true);
  2809	  if (version > GAME_SCHEMA_VERSION) {
  2810	    throw new UnsupportedGameSchemaError(version, GAME_SCHEMA_VERSION);
  2811	  }
  2812	  while (version < GAME_SCHEMA_VERSION) {
  2813	    const step = GAME_STATE_MIGRATIONS.find(migration => migration.to === version + 1);
  2814	    if (step === undefined) {
  2815	      throw new UnsupportedGameSchemaError(version, GAME_SCHEMA_VERSION);
  2816	    }
  2817	    if (!isRecord(current)) {
  2818	      throw new CorruptCareerSaveError(`schema ${version} save is not an object`);
  2819	    }
  2820	    const upgraded = step.up(current);
  2821	    if (!isRecord(upgraded)) {
  2822	      throw new CorruptCareerSaveError(`schema migration to ${step.to} produced a non-object`);
  2823	    }
  2824	    current = { ...upgraded, schemaVersion: step.to };
  2825	    version = step.to;
  2826	  }
  2827	  return current;
  2828	}
  2829	
  2830	function assertSupportedSchema(value: unknown, stored: boolean): void {
  2831	  const version = readSchemaVersion(value, stored);
  2832	  if (version !== GAME_SCHEMA_VERSION) {
  2833	    throw new UnsupportedGameSchemaError(version, GAME_SCHEMA_VERSION);
  2834	  }
  2835	}
  2836	
  2837	function isRecord(value: unknown): value is Record<string, unknown> {
  2838	  return typeof value === 'object' && value !== null && !Array.isArray(value);
  2839	}
  2840	
  2841	function formatIssues(issues: z.core.$ZodIssue[]): string {
  2842	  return issues
  2843	    .slice(0, 3)
  2844	    .map((issue) => `${issue.path.join('.') || 'state'} ${issue.message}`)
  2845	    .join('; ');

