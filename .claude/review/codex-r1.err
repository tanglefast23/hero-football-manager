   150	 * move of the cup calendar sends the manager to a tab that is not there.
   151	 *
   152	 * Monotonic in career time, not in the week counter. `week` restarts at 1 every
   153	 * season, so a threshold compared against the week alone re-locks the tab for
   154	 * the opening weeks of every season after the first — hiding live boards from a
   155	 * veteran career, and silently, because Bert's briefing only fires once.
   156	 *
   157	 * A career with no cup drawn never unlocks: there is no first match to count
   158	 * from.
   159	 */
   160	export function isDivisionLeadersUnlocked(
   161	  cups: readonly NationalCup[],
   162	  season: number,
   163	  week: number,
   164	): boolean {
   165	  const first = firstCupMatch(cups);
   166	  if (first === null) return false;
   167	  if (season !== first.season) return season > first.season;
   168	  return week >= first.week + DIVISION_LEADERS_UNLOCK_WEEKS_AFTER_FIRST_CUP;
   169	}
