    26	 * one width — M, N and V are 1.0em where most are 0.875em and E is 0.75em — so
    27	 * these are per-word totals for the words the register actually renders. The
    28	 * labels are typed in title case and uppercased by the stylesheet; what is
    29	 * measured here is what is drawn.
    30	 */
    31	export const HEADER_LABEL_ADVANCE_EM: Readonly<Record<string, number>> = {
