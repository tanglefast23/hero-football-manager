     2	  CELL_MAX_FONT_MULTIPLIER,
     3	  HEADER_MAX_FONT_MULTIPLIER,
     4	  LEAGUE_CELL_ADVANCE_EM,
     5	  LEAGUE_CELL_FONT_SIZE,
