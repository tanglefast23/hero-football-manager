   577	function sponsorOfferViewModel(
   578	  offer: SponsorOfferSnapshot,
   579	  contracts: readonly SponsorContractSnapshot[],
   580	  sponsorPercent: number,
   581	) {
   582	  const hypothetical: SponsorContractSnapshot[] = contracts.map(contract => contract.slot === offer.slot
   583	    ? {
   584	        contractId: `preview-${offer.offerId}`,
   585	        sponsorContentId: offer.sponsorContentId,
   586	        sponsorName: offer.sponsorName,
   587	        offerLine: offer.offerLine,
   588	        season: offer.season,
   589	        slot: offer.slot,
   590	        nominalMonthlyFee: offer.nominalMonthlyFee,
   591	        profile: offer.profile,
   592	        objective: offer.objective,
   593	        provisional: false,
   594	      }
   595	    : contract);
   596	  const previewId = `preview-${offer.offerId}`;
   597	  const actualMonthlyFee = allocateSponsorPortfolioPayment(hypothetical, sponsorPercent)
   598	    .find(allocation => allocation.contractId === previewId)?.actualAmount ?? 0;
   599	  const actualBonus = actualObjectiveBonuses(hypothetical, sponsorPercent).get(previewId) ?? 0;
   600	  return {
   601	    offerId: offer.offerId,
   602	    sponsorName: offer.sponsorName,
   603	    offerLine: offer.offerLine,
   604	    profile: offer.profile,
   605	    profileLabel: offer.profile === 'STEADY'
   606	      ? 'Steady'
   607	      : offer.profile === 'BALANCED' ? 'Balanced' : 'Bold',
   608	    nominalMonthlyFee: offer.nominalMonthlyFee,
   609	    actualMonthlyFee,
   610	    objectiveLabel: offer.objective.label,
   611	    nominalBonus: offer.objective.nominalBonus,
   612	    actualBonus,
   613	  };
   614	}
