   381	function clonePreferences(preferences: AppPreferences): AppPreferences {
   382	  return {
   383	    ...preferences,
   384	    formationPresets: [...preferences.formationPresets],
   385	    seenPowerCutIns: [...preferences.seenPowerCutIns],
