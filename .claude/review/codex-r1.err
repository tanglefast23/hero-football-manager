    65	  const opponentDivision = divisions[opponentClubId];
    66	  if (userDivision === undefined || opponentDivision === undefined) return undefined;
    67	  const divisionGap = userDivision - opponentDivision;
    68	  if (divisionGap < 1) return undefined;
    69	  const copy = CUP_UPSET_COPY_BY_GAP[divisionGap as keyof typeof CUP_UPSET_COPY_BY_GAP];
    70	  if (copy === undefined) return undefined;
    71	  return { fixtureId: fixture.id, divisionGap, ...copy };
    72	}
