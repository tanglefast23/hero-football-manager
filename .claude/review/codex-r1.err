   362	function ordinal(position: number): string {
   363	  const tens = position % 100;
   364	  if (tens >= 11 && tens <= 13) return `${position}th`;
   365	  const units = position % 10;
   366	  if (units === 1) return `${position}st`;
   367	  if (units === 2) return `${position}nd`;
   368	  if (units === 3) return `${position}rd`;
   369	  return `${position}th`;
