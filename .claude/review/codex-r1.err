  2596	    margin: number;
  2597	    cupTie?: { opponentClubId: string; season: number };
  2598	  },
  2599	): FulltimeCoachLinePool {
  2600	  const { outcomeLabel, margin, cupTie } = result;
  2601	  // A cup tie is settled on the day, so a DRAW here means the round has not
  2602	  // been resolved yet. The league's level-game lines are the honest answer.
  2603	  if (cupTie === undefined || outcomeLabel === 'DRAW') {
  2604	    if (outcomeLabel === 'DRAW') return 'leagueDraw';
  2605	    const heavy = margin >= BLOWOUT_MARGIN;
  2606	    if (outcomeLabel === 'WIN') return heavy ? 'leagueWinBig' : 'leagueWinClose';
  2607	    return heavy ? 'leagueLossBig' : 'leagueLossClose';
  2608	  }
  2609	  const tiersAbove = cupOpponentTiersAbove(state, cupTie);
  2610	  if (outcomeLabel === 'WIN') {
