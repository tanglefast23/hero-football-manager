   531	  const [drillFocusToken, setDrillFocusToken] = useState<number | null>(null);
   532	  const [managerTipGuideRequest, setManagerTipGuideRequest] = useState<{
   533	    target: ManagerTipDestination;
   534	    token: number;
   535	  } | null>(null);
