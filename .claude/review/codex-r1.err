   540	  const [fontsLoaded, fontError] = useFonts({ Silkscreen_400Regular, Silkscreen_700Bold });
   541	  const [globalSettingsOpen, setGlobalSettingsOpen] = useState(false);
   542	  const [globalGlossaryOpen, setGlobalGlossaryOpen] = useState(false);
