    26	  for (const fixture of fixtures) {
    27	    const home = fixture.homeClubId === state.userClubId;
    28	    const scored = home ? fixture.score!.homeGoals : fixture.score!.awayGoals;
    29	    const conceded = home ? fixture.score!.awayGoals : fixture.score!.homeGoals;
    30	    goalsFor += scored;
    31	    goalsAgainst += conceded;
    32	    if (scored > conceded) won += 1;
    33	    else if (scored < conceded) lost += 1;
    34	    else drawn += 1;
    35	  }
    36	
    37	  const club = state.clubs.find(candidate => candidate.id === state.userClubId);
    38	  if (club === undefined) throw new Error(`unknown user club ${state.userClubId}`);
    39	  const cashChange = club.cash - seasonOpeningCash(state, club.cash);
    40	  const roster = state.players.filter(player => player.clubId === state.userClubId);
    41	  // Both competitions: the Golden Boot is the club's own award, and it counted
    42	  // cup goals before stat lines were split by competition. Only the division
    43	  // board is league-only.
    44	  const goalsByPlayer = new Map<string, number>();
    45	  for (const line of state.seasonStatLines ?? []) {
    46	    if (line.season !== state.season) continue;
    47	    goalsByPlayer.set(line.playerId, (goalsByPlayer.get(line.playerId) ?? 0) + line.goals);
    48	  }
    49	  const sortedScorers = roster.slice().sort((left, right) => (
    50	    (goalsByPlayer.get(right.id) ?? 0) - (goalsByPlayer.get(left.id) ?? 0)
    51	    || playerScore(right) - playerScore(left)
    52	    || compareIds(left.id, right.id)
    53	  ));
    54	  const sortedPlayers = roster.slice().sort((left, right) => (
    55	    playerSeasonScore(right, goalsByPlayer) - playerSeasonScore(left, goalsByPlayer)
