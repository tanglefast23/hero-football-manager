     6	
     7	/**
     8	 * Marks a file as one of ours. A foreign JSON file is refused on this field
     9	 * alone, before anything reads the career out of it.
    10	 */
    11	export const SAVE_FILE_FORMAT = 'hero-football-manager-career';
    12	
    13	/**
    14	 * The envelope's own version, separate from the game schema version it carries:
    15	 * the wrapper can gain fields without touching the save shape, and vice versa.
    16	 */
    17	export const SAVE_FILE_FORMAT_VERSION = 1;
    18	
    19	/**
    20	 * What an exported file contains. Self-describing on purpose — an import decides
    21	 * whether it can read the file from the envelope, without having to guess from
    22	 * the state inside it.
    23	 */
    24	export interface CareerSaveFileEnvelope {
    25	  readonly format: typeof SAVE_FILE_FORMAT;
    26	  readonly formatVersion: number;
    27	  /** The save schema the career was written at; drives the migration ladder. */
    28	  readonly gameSchemaVersion: number;
    29	  /** The match engine that wrote it. Recorded, never enforced — see below. */
    30	  readonly engineVersion: string;
    31	  readonly state: unknown;
    32	}
    33	
    34	export interface DecodedCareerSaveFile {
