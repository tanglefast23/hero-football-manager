     1	import type { GameState } from './types';
     2	
     3	/**
     4	 * Manager's tips: one non-obvious rule, offered on a quiet week, never twice.
     5	 *
     6	 * "Never twice" is the whole design. A tip the player has already read is noise
     7	 * on a desk that only shows it because the week was empty, and a hint system
     8	 * that repeats itself teaches people to stop reading hints. Seen tips are
     9	 * recorded as career flags, so the catalog drains across a playthrough and a
    10	 * long career eventually stops offering any.
    11	 */
    12	
    13	const SEEN_TIP_PREFIX = 'tip:seen:';
    14	
    15	export interface DeskTipState {
    16	  readonly season: number;
    17	  readonly week: number;
    18	  /** Absent when the week was settled and the roll came up empty. */
    19	  readonly tipId?: string;
    20	}
    21	
    22	export function hasSeenDeskTip(state: Pick<GameState, 'eventFlags'>, tipId: string): boolean {
    23	  return state.eventFlags.includes(seenTipFlag(tipId));
    24	}
    25	
    26	export function markDeskTipSeen(state: GameState, tipId: string): GameState {
    27	  const flag = seenTipFlag(tipId);
    28	  if (state.eventFlags.includes(flag)) return state;
    29	  return { ...state, eventFlags: [...state.eventFlags, flag] };
    30	}
    31	
    32	/** The tips this career has not been shown, in catalog order. */
    33	export function unseenDeskTipIds(
    34	  state: Pick<GameState, 'eventFlags'>,
    35	  tipIds: readonly string[],
    36	): string[] {
    37	  return tipIds.filter(tipId => !hasSeenDeskTip(state, tipId));
    38	}
    39	
    40	/** True once this week has already been decided, whether or not a tip landed. */
    41	export function isDeskTipSettled(state: Pick<GameState, 'deskTip' | 'season' | 'week'>): boolean {
    42	  return state.deskTip?.season === state.season && state.deskTip.week === state.week;
    43	}
    44	
    45	/** The tip showing right now, or undefined on a week that drew a blank. */
    46	export function currentDeskTipId(
    47	  state: Pick<GameState, 'deskTip' | 'season' | 'week'>,
    48	): string | undefined {
    49	  return isDeskTipSettled(state) ? state.deskTip?.tipId : undefined;
    50	}
    51	
    52	function seenTipFlag(tipId: string): string {
    53	  if (typeof tipId !== 'string' || tipId.trim().length === 0) {
    54	    throw new Error('manager tip IDs must be non-empty strings');
    55	  }
    56	  return `${SEEN_TIP_PREFIX}${tipId}`;
    57	}

