   393	function cupRoundHistory(
   394	  round: NationalCupRound,
   395	  cup: NationalCup,
   396	  userClubId: string,
   397	): M2CupRoundHistoryViewModel {
   398	  const completedCount = round.fixtures.filter(fixture => fixture.status === 'played').length;
   399	  const userFixture = round.fixtures.find(fixture =>
   400	    fixture.homeClubId === userClubId || fixture.awayClubId === userClubId,
   401	  );
   402	  let userOutcome: string | undefined;
   403	  if (round.byeClubIds.includes(userClubId)) {
   404	    userOutcome = 'Bye';
   405	  } else if (userFixture?.status === 'scheduled') {
   406	    userOutcome = 'Tie waiting';
   407	  } else if (userFixture?.winnerClubId === userClubId) {
   408	    userOutcome = cup.championClubId === userClubId && round.label === 'Final'
   409	      ? 'Champion'
   410	      : 'Advanced';
   411	  } else if (userFixture?.winnerClubId !== undefined) {
   412	    userOutcome = 'Eliminated';
   413	  }
   414	  return {
   415	    round: round.number,
   416	    label: round.label,
   417	    matchCount: round.fixtures.length,
   418	    completedCount,
   419	    statusLabel: completedCount === round.fixtures.length ? 'Complete' : 'Live',
   420	    ...(userOutcome === undefined ? {} : { userOutcome }),
   421	  };
   422	}
