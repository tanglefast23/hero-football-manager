   107	
   108	export type LeagueColumn = keyof typeof LEAGUE_COLUMN_WIDTH;
   109	
   110	/** Width a header needs at its size cap, plus the gutter to its neighbour. */
   111	export function leagueHeaderWidthDemand(label: string): number {
   112	  const advanceEm = LEAGUE_HEADER_ADVANCE_EM[label];
