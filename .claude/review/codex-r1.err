   280	export function applyCareerEventOutcome(
   281	  state: GameState,
   282	  choiceId: string,
   283	  outcomeText: string,
   284	  application: CareerEventOutcomeApplication,
   285	  presentation?: CareerEventResolutionPresentation,
   286	): GameState {
   287	  if (state.pendingEvent === undefined) throw new Error('there is no pending event');
   288	  if (state.pendingEvent.resolvedChoiceId !== undefined) {
   289	    throw new Error('the event outcome has already resolved');
   290	  }
   291	  if (choiceId.trim().length === 0 || outcomeText.trim().length === 0) {
   292	    throw new Error('resolved event choice and outcome text must be non-empty');
   293	  }
   294	  if (presentation !== undefined
   295	    && (!Number.isSafeInteger(presentation.outcomeIndex) || presentation.outcomeIndex < 0)) {
   296	    throw new Error('resolved event outcome index must be a nonnegative safe integer');
   297	  }
   298	
   299	  const moneyDelta = safeDelta(application.moneyDelta ?? 0, 'event money');
   300	  const trainingPointDelta = safeDelta(application.trainingPointDelta ?? 0, 'event TP');
   301	  const fanDelta = safeDelta(application.fanDelta ?? 0, 'event fans');
   302	  const club = state.clubs.find(candidate => candidate.id === state.userClubId);
   303	  if (club === undefined) throw new Error(`unknown user club ${state.userClubId}`);
   304	
   305	  const cash = safeAdd(club.cash, moneyDelta, 'event cash balance');
   306	  const trainingPoints = safeAdd(state.trainingPoints, trainingPointDelta, 'event TP balance');
   307	  if (trainingPoints < 0) throw new Error('event effects cannot make TP negative');
   308	  // A fan setback floors at zero the same way a board forced sale does. A club
   309	  // the league has nearly abandoned must still be able to resolve its story.
   310	  const fans = Math.max(0, safeAdd(club.fans, fanDelta, 'event fan balance'));
   311	
   312	  const flags = [...state.eventFlags];
   313	  for (const flag of application.flags ?? []) {
   314	    if (typeof flag !== 'string' || flag.trim().length === 0) {
   315	      throw new Error('event flags must be non-empty strings');
   316	    }
   317	    if (!flags.includes(flag)) flags.push(flag);
   318	  }
   319	
   320	  const resolved: GameState = {
   321	    ...state,
   322	    clubs: state.clubs.map(candidate =>
   323	      candidate.id === state.userClubId ? { ...candidate, cash, fans } : candidate,
   324	    ),
   325	    trainingPoints,
   326	    eventFlags: flags,
   327	    players: applyPlayerEffect(state, application.playerEffect),
   328	    pendingEvent: {
   329	      ...state.pendingEvent,
   330	      resolvedChoiceId: choiceId,
   331	      outcomeText,
   332	      ...(presentation === undefined ? {} : {
   333	        resolvedOutcomeIndex: presentation.outcomeIndex,
   334	        resolvedRisky: presentation.risky,
   335	        resolvedSuccess: presentation.success,
   336	        ...(presentation.nextEventId === undefined
   337	          ? {}
   338	          : { resolvedNextEventId: presentation.nextEventId }),
   339	      }),
   340	    },
   341	  };
