    51	 */
    52	export function cupGiantKillingCelebration(
    53	  state: GameState,
    54	  fixture: NationalCupFixture,
    55	  winnerClubId: string,
    56	): CupGiantKillingCelebration | undefined {
    57	  if (winnerClubId !== state.userClubId) return undefined;
    58	  const cup = state.m2?.nationalCups.find(candidate => candidate.season === fixture.season);
    59	  const divisions = cup?.seedDivisionByClubId;
    60	  if (divisions === undefined) return undefined;
    61	  const opponentClubId = fixture.homeClubId === state.userClubId
    62	    ? fixture.awayClubId
    63	    : fixture.homeClubId;
