   430	export function resolvePromotionAndRelegation(
   431	  pyramid: LeaguePyramid,
   432	  finishOrders: readonly DivisionFinishOrder[],
   433	): PyramidSeasonResolution {
   434	  validatePyramid(pyramid);
   435	  validateFinishOrders(pyramid, finishOrders);
   436	  const orderByDivision = new Map(finishOrders.map(order => [order.division, order.orderedClubIds]));
   437	  const movements: DivisionMovement[] = [];
   438	  const targetDivisionByClubId = new Map<string, DivisionLevel>();
   439	
   440	  for (const division of pyramid.divisions) {
   441	    const orderedClubIds = orderByDivision.get(division.level)!;
   442	    for (let index = 0; index < orderedClubIds.length; index += 1) {
   443	      const clubId = orderedClubIds[index];
   444	      const toDivision = divisionAfterFinish(division.level, index + 1);
   445	      targetDivisionByClubId.set(clubId, toDivision);
   446	      if (toDivision < division.level) {
   447	        movements.push({ clubId, fromDivision: division.level, toDivision, kind: 'promoted' });
   448	      } else if (toDivision > division.level) {
   449	        movements.push({ clubId, fromDivision: division.level, toDivision, kind: 'relegated' });
   450	      }
   451	    }
   452	  }
   453	
   454	  const allClubs = pyramid.divisions.flatMap(division => division.clubs).map(club => {
   455	    const division = targetDivisionByClubId.get(club.id)!;
   456	    return cloneClub({ ...club, division });
   457	  });
   458	  const divisions = divisionLevels().map(level => ({
   459	    level,
   460	    clubs: allClubs
   461	      .filter(club => club.division === level)
   462	      .sort((left, right) => compareIds(left.id, right.id)),
   463	  }));
   464	
   465	  return {
   466	    pyramid: { careerSeed: pyramid.careerSeed, divisions },
   467	    movements: movements.sort((left, right) => compareIds(left.clubId, right.clubId)),
   468	  };
   469	}
