   318	/**
   319	 * The man who scored most of the club's goals, as far as the save can tell.
   320	 *
   321	 * Built from the per-season Golden Boot alone, and deliberately not blended
   322	 * with `divisionAwards.goals`: that board is strikers-only and league-only, so
   323	 * mixing the two would produce a total nobody could explain and would rank a
   324	 * midfielder below a worse striker. One source, one sentence.
   325	 */
   326	function careerTopScorer(recaps: readonly SeasonRecap[]): HallOfFameScorer | undefined {
   327	  const byPlayer = new Map<string, HallOfFameScorer>();
   328	  for (const recap of recaps) {
   329	    const award = recap.topScorer;
   330	    if (award === undefined) continue;
   331	    const existing = byPlayer.get(award.playerId);
   332	    const goals = goldenBootGoals(award.detail);
   333	    if (existing === undefined) {
   334	      byPlayer.set(award.playerId, {
   335	        playerId: award.playerId,
   336	        // Denormalised at the moment it was true: the man may have retired,
   337	        // been sold, or had his ID recycled by a regenerated rival roster.
   338	        playerName: award.playerName,
   339	        goals,
   340	        goldenBoots: 1,
   341	      });
   342	      continue;
   343	    }
   344	    existing.goals += goals;
   345	    existing.goldenBoots += 1;
   346	  }
   347	  return [...byPlayer.values()].sort((left, right) => (
   348	    right.goals - left.goals
   349	    || right.goldenBoots - left.goldenBoots
   350	    || compareIds(left.playerId, right.playerId)
   351	  ))[0];
   352	}
