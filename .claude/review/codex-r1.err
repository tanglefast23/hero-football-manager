    57	export function playerRequestViewModel(state: GameState): PlayerRequestViewModel {
    58	  const catalog = state.playerRequestRules;
    59	  const pending = state.playerRequests?.pending;
    60	  const available = catalog !== undefined
    61	    && (state.season > catalog.tuning.startSeason
    62	      || (state.season === catalog.tuning.startSeason && state.week >= catalog.tuning.startWeek));
    63	
    64	  const history = catalog === undefined
    65	    ? []
    66	    : (state.playerRequests?.history ?? []).map((entry, index) => ({
    67	        key: `${entry.requestId}-${entry.season}-${entry.week}-${index}`,
    68	        label: `${requestDefinition(catalog, entry.requestId).title} · S${entry.season} W${entry.week}`,
    69	        resolution: entry.resolution,
    70	      }));
    71	
    72	  if (!available || catalog === undefined || pending === undefined) {
    73	    return { available, glowing: false, history, emptyDetail: EMPTY_DETAIL };
    74	  }
    75	
    76	  const definition = requestDefinition(catalog, pending.requestId);
    77	  const player = state.players.find(candidate => candidate.id === pending.playerId);
    78	  const difficulty = careerDifficulty(state);
    79	  const refuse = resolutionDeltas('REFUSED', requestTarget(definition.cost), difficulty).asker;
    80	
    81	  return {
    82	    available,
    83	    glowing: true,
    84	    history,
    85	    emptyDetail: EMPTY_DETAIL,
    86	    pending: {
    87	      requestId: definition.id,
    88	      playerId: pending.playerId,
    89	      playerName: player?.name ?? 'A player',
    90	      playerRole: player?.role ?? 'MID',
    91	      ...(player?.lookId === undefined ? {} : { lookId: player.lookId }),
    92	      title: definition.title,
    93	      line: definition.line,
    94	      artKey: `request-${definition.id}`,
    95	      grantLabel: grantLabel(definition, pending.costAmount, difficulty),
    96	      refuseLabel: `−${Math.abs(refuse.loyalty)} loyalty · −${Math.abs(refuse.morale)} morale`,
    97	      canAfford: canAffordRequest(state),
    98	      weeksToAnswer: Math.max(0, catalog.tuning.answerWeeks - (state.week - pending.askedWeek)),
    99	    },
   100	  };
   101	}
