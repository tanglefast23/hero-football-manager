   389	
   390	export function replaceFormationPreset(
   391	  preferences: AppPreferences,
   392	  slot: number,
   393	  coachUnlockedFormationIds: readonly string[] = [],
   394	): AppPreferences {
   395	  if (!Number.isInteger(slot) || slot < 0 || slot > 2) return preferences;
   396	  const available = availableFormationIds(preferences, coachUnlockedFormationIds);
   397	  const current = preferences.formationPresets[slot];
   398	  let index = available.indexOf(current);
   399	  index = (index + 1) % available.length;
   400	  const next = available[index];
   401	  const formationPresets: [FormationId, FormationId, FormationId] = [...preferences.formationPresets];
   402	  const occupiedSlot = formationPresets.indexOf(next);
   403	  formationPresets[slot] = next;
   404	  // When every available base formation already occupies one of the three
   405	  // slots, tapping still reorders the live-match cycle instead of doing
   406	  // nothing. A newly taught fourth shape simply replaces the selected slot.
   407	  if (occupiedSlot >= 0 && occupiedSlot !== slot) formationPresets[occupiedSlot] = current;
   408	  return { ...preferences, formationPresets };
   409	}
   410	
   411	/**
   412	 * Settings exposes the proven base shapes plus formations taught by a hired
   413	 * coach. A formation already present in an older settings row is retained as
   414	 * a grandfathered choice so loading a save never silently rewrites its match
   415	 * tactics. Unknown content IDs are ignored at this pure persistence boundary.
   416	 */
   417	export function availableFormationIds(
   418	  preferences: AppPreferences,
   419	  coachUnlockedFormationIds: readonly string[] = [],
   420	): FormationId[] {
   421	  const available = new Set<FormationId>(DEFAULT_FORMATION_PRESETS);
   422	  for (const formation of coachUnlockedFormationIds) {
   423	    if (isFormationId(formation) && COACHING_FORMATION_IDS.includes(formation)) {
   424	      available.add(formation);
   425	    }
   426	  }
   427	  for (const formation of preferences.formationPresets) available.add(formation);
   428	  return FORMATION_IDS.filter(formation => available.has(formation));
   429	}

