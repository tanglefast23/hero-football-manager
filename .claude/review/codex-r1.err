   471	/** Creates the 50-club Hero Cup. Fourteen clubs receive deterministic play-in byes. */
   472	export function createNationalCup(
   473	  clubIds: readonly string[],
   474	  season: number,
   475	  careerSeed: number,
   476	  seedDivisionByClubId?: Readonly<Record<string, DivisionLevel>>,
   477	): NationalCup {
   478	  validateClubIds(clubIds, NATIONAL_CUP_CLUB_COUNT, 'Hero Cup');
   479	  validateSeason(season);
   480	  validateSeed(careerSeed);
   481	  const sortedClubIds = [...clubIds].sort(compareIds);
   482	  const seedDivisions = seedDivisionByClubId === undefined
   483	    ? undefined
   484	    : validateCupSeedDivisions(sortedClubIds, seedDivisionByClubId);
   485	  const firstRound = createCupRound(sortedClubIds, season, 1, careerSeed, seedDivisions);
   486	  return {
   487	    careerSeed,
   488	    season,
   489	    rounds: [firstRound],
   490	    ...(seedDivisions === undefined ? {} : { seedDivisionByClubId: seedDivisions }),
   491	  };
   492	}
   493	
   494	/** Completes the current cup round and produces the next one, or names the champion. */
   495	export function advanceNationalCup(
   496	  cup: NationalCup,
   497	  results: readonly NationalCupResult[],
   498	): NationalCup {
   499	  validateSeason(cup.season);
   500	  validateSeed(cup.careerSeed);
   501	  if (cup.championClubId !== undefined) throw new Error('the Hero Cup is already complete');
   502	  if (cup.rounds.length < 1 || cup.rounds.length > 6) throw new Error('the Hero Cup has invalid rounds');
   503	  const current = cup.rounds[cup.rounds.length - 1];
   504	  if (current.fixtures.some(fixture => fixture.status !== 'scheduled')) {
   505	    throw new Error('the current Hero Cup round has already been resolved');
   506	  }
   507	  if (results.length !== current.fixtures.length) {
   508	    throw new Error(`Hero Cup round ${current.number} requires exactly ${current.fixtures.length} results`);
   509	  }
   510	  const resultByFixtureId = new Map<string, NationalCupResult>();
   515	
   516	  const winners: string[] = [];
   517	  const fixtures = current.fixtures.map(fixture => {
   518	    const result = resultByFixtureId.get(fixture.id);
   519	    if (result === undefined) throw new Error(`missing result for ${fixture.id}`);
   520	    validateCupResult(fixture, result);
   521	    winners.push(result.winnerClubId);
   522	    return {
   523	      ...fixture,
   524	      status: 'played' as const,
   525	      score: { homeGoals: result.homeGoals, awayGoals: result.awayGoals },
   526	      winnerClubId: result.winnerClubId,
   527	    };
   528	  });
   529	  const resolvedRound = { ...current, fixtures };
   530	  const rounds = [...cup.rounds.slice(0, -1), resolvedRound];
   531	  const advancingClubIds = [...current.byeClubIds, ...winners];
   532	
   533	  if (advancingClubIds.length === 1) {
   534	    return { ...cup, rounds, championClubId: advancingClubIds[0] };
   535	  }
   536	  const nextRound = createCupRound(
   537	    advancingClubIds.sort(compareIds),
   538	    cup.season,
   539	    current.number + 1,
   540	    cup.careerSeed,
   541	    cup.seedDivisionByClubId,
   542	  );
   543	  return { ...cup, rounds: [...rounds, nextRound] };
   544	}
