    80	 * rather than the reader losing the number.
    81	 */
    82	export const CELL_MAX_FONT_MULTIPLIER = 1.6;
    83	
    84	/** Clear space between a column and the one beside it, at the size cap. */
    85	export const COLUMN_MIN_GUTTER = 4;
    86	
    87	/**
    88	 * Fixed column widths, each the larger of its header demand and its widest
