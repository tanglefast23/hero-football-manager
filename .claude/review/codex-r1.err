   421	function AwakeningArtQaApp({ triggerId }: { triggerId: string }) {
   422	  const content = useMemo(loadLaunchContent, []);
   423	  const [selectedTriggerIndex, setSelectedTriggerIndex] = useState(() => {
   424	    const requestedIndex = content.onboarding.triggers.findIndex(candidate => candidate.id === triggerId);
   425	    return requestedIndex >= 0 ? requestedIndex : 0;
   426	  });
   427	  const triggerCount = content.onboarding.triggers.length;
   428	  const triggerIndex = Math.min(selectedTriggerIndex, triggerCount - 1);
   429	  const [fontsLoaded] = useFonts({ Silkscreen_400Regular, Silkscreen_700Bold });
   430	  const trigger = content.onboarding.triggers[triggerIndex];
   431	
   432	  if (!fontsLoaded) return <LoadingScreen />;
   433	  return (
   434	    <SafeAreaProvider>
   435	      <StatusBar style="light" />
   436	      <AwakeningArtQaScreen
   437	        index={triggerIndex}
   438	        total={triggerCount}
   439	        title={trigger.title}
   440	        callout={trigger.callout}
   441	        visual={trigger.visual}
   442	        onPrevious={() => setSelectedTriggerIndex((
   443	          triggerIndex - 1 + triggerCount
   444	        ) % triggerCount)}
   445	        onNext={() => setSelectedTriggerIndex((triggerIndex + 1) % triggerCount)}
   446	      />
   447	    </SafeAreaProvider>
   448	  );
   449	}
