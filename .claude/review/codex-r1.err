   197	/**
   198	 * Fame enters at a tenth of its face value, and has to.
   199	 *
   200	 * This picks the season's player, and the other three terms are a season's
   201	 * work: a few hundred points of attributes, thirty a goal, a morale reading out
   202	 * of 100. Fame is a career total that runs to `FAME_CEILING`, so added whole it
   203	 * would outweigh every one of them and the award would go to whoever had been
   204	 * here longest, every year, forever. A tenth keeps it worth what it was worth
   205	 * when the ceiling was 99: a nudge between close candidates.
   206	 */
   207	function playerSeasonScore(player: CareerPlayer, goals: ReadonlyMap<string, number>): number {
   208	  return playerScore(player)
   209	    + (goals.get(player.id) ?? 0) * 30
   210	    + (player.morale ?? 0)
   211	    + Math.round((player.fame ?? 0) / 10);
   212	}
