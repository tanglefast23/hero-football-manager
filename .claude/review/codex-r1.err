     1	/**
     2	 * The game ring's tiebreaks, in one place.
     3	 *
     4	 * Everything here is a total order over data the ring already holds, so a sort
     5	 * never depends on the order rows happened to arrive in.
     6	 */
     7	
     8	/**
     9	 * Orders two internal identifiers — club, player, or fixture.
    10	 *
    11	 * DELIBERATELY NOT `String.prototype.localeCompare`. That method is
    12	 * host-defined: its collation table comes from the JavaScript engine's own
    13	 * locale data, so Hermes on device need not order the same two strings the way
    14	 * V8 does under Jest. `src/game/` and `src/sim/` must produce byte-identical
    15	 * results from the same seed on every platform (see CLAUDE.md), and these
    16	 * comparisons decide real outcomes — which club is promoted, which player takes
    17	 * a podium, which bid is accepted. A comparator that can disagree across engines
    18	 * is a cross-platform determinism hazard even while every shipped ID is a
    19	 * lowercase ASCII slug and the two orderings happen to agree.
    20	 *
    21	 * Plain `<`/`>` compares UTF-16 code units, which the language pins.
    22	 *
    23	 * Please do not "improve" this back to `localeCompare`. These are internal
    24	 * slugs, never text a player reads, so there is no human-facing ordering for a
    25	 * locale to get right. Display lists that a person reads alphabetically are a
    26	 * different problem and belong in the UI ring.
    27	 */
    28	export function compareIds(left: string, right: string): number {
    29	  return left < right ? -1 : left > right ? 1 : 0;
    30	}
    31	
    32	/** The fields the league table's order is decided by, and only those. */
    33	interface StandingsOrder {
    34	  readonly clubId: string;
    35	  readonly points: number;
    36	  readonly goalDifference: number;
    37	  readonly goalsFor: number;
    38	}
    39	
    40	/**
    41	 * The league table's order, and the only definition of it.
    42	 *
    43	 * Points, then goal difference, then goals for, then the club ID so the table
    44	 * is total. Shared rather than reimplemented because two functions decide the
    45	 * same thing from it: `leagueStandings` drives promotion, relegation and prize
    46	 * money, and `finalPosition` writes the finish into the season recap that the
    47	 * awards ceremony prices its prize against. They disagreed once — the recap
    48	 * tiebroke with `localeCompare` — which is a ceremony framing a promotion the
    49	 * transition never grants.
    50	 */
    51	export function compareStandings(left: StandingsOrder, right: StandingsOrder): number {
    52	  if (left.points !== right.points) return left.points > right.points ? -1 : 1;
    53	  if (left.goalDifference !== right.goalDifference) {
    54	    return left.goalDifference > right.goalDifference ? -1 : 1;
    55	  }
    56	  if (left.goalsFor !== right.goalsFor) return left.goalsFor > right.goalsFor ? -1 : 1;
    57	  return compareIds(left.clubId, right.clubId);
    58	}

