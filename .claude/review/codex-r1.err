   172	/**
   173	 * Three deterministic candidates for every still-provisional slot.
   174	 *
   175	 * This deliberately owns a tiny hash stream instead of borrowing the match or
   176	 * event RNG. Offer reconciliation can run repeatedly without consuming any
   177	 * simulation value, and the same persisted inputs rebuild byte-identical terms.
   178	 */
   179	export function generateSponsorOffers(
   180	  context: SponsorOfferGenerationContext,
   181	): SponsorOfferSnapshot[] {
   182	  validateOfferGenerationContext(context);
   183	  const brandIds = new Set(context.rules.brands.map(brand => brand.id));
   184	  const usedBrandIds = new Set(
   185	    context.activeContracts
   186	      .map(contract => contract.sponsorContentId)
   187	      .filter(contentId => brandIds.has(contentId)),
   188	  );
   189	  const offers: SponsorOfferSnapshot[] = [];
   190	
   191	  const provisionalContracts = [...context.activeContracts]
   192	    .filter(contract => contract.season === context.season && contract.provisional)
   193	    .sort((left, right) => left.slot - right.slot || compareIds(left.contractId, right.contractId));
   194	
   195	  for (const contract of provisionalContracts) {
   196	    const objectiveOffset = deterministicSponsorIndex(
   197	      context,
   198	      contract.slot,
   199	      'objective-family',
   200	      context.rules.objectives.length,
   201	    );
   202	
   203	    for (let candidateIndex = 0; candidateIndex < SPONSOR_PROFILES.length; candidateIndex += 1) {
   204	      const profile = SPONSOR_PROFILES[candidateIndex];
   205	      const brand = chooseSponsorBrand(
   206	        context,
   207	        contract.slot,
   208	        profile,
   209	        candidateIndex,
   210	        usedBrandIds,
   211	      );
   212	      usedBrandIds.add(brand.id);
   213	
   214	      const objectiveDefinition = context.rules.objectives[
   215	        (objectiveOffset + candidateIndex) % context.rules.objectives.length
   216	      ];
   217	      const profileDefinition = context.rules.profiles[profile];
   218	      const target = objectiveTarget(
   219	        objectiveDefinition.kind,
   220	        objectiveDefinition.targets[profileDefinition.objectiveLevel],
   221	        objectiveDefinition.chairmanDelta,
   222	        context,
   223	      );
   224	      const nominalMonthlyFee = percentOfMoney(
   225	        contract.nominalMonthlyFee,
   226	        profileDefinition.monthlyPercent,
   227	        'sponsor monthly offer',
   228	      );
   229	      const nominalBonus = percentOfMoney(
   230	        contract.nominalMonthlyFee,
   231	        profileDefinition.bonusPercentByObjective?.[objectiveDefinition.kind]
   232	          ?? profileDefinition.bonusPercent,
   233	        'sponsor objective bonus',
   234	      );
   235	
   236	      offers.push({
   237	        offerId: `offer-s${context.season}-slot${contract.slot}-${profile.toLowerCase()}-${brand.id}`,
   238	        sponsorContentId: brand.id,
   239	        sponsorName: brand.name,
   240	        offerLine: brand.offerLine,
   241	        season: context.season,
   242	        slot: contract.slot,
   243	        profile,
   244	        nominalMonthlyFee,
   245	        objective: {
   246	          kind: objectiveDefinition.kind,
   247	          label: objectiveDefinition.labelTemplate.replace('{target}', String(target)),
   248	          target,
   249	          nominalBonus,
   250	        },
   251	      });
   252	    }
   253	  }
   254	
   255	  return offers;
   256	}
