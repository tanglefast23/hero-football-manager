    57	  ));
    58	  const topScorerGoals = sortedScorers[0] === undefined
    59	    ? 0
    60	    : goalsByPlayer.get(sortedScorers[0].id) ?? 0;
    61	  const young = sortedPlayers.filter(player => (player.age ?? 99) <= 21)[0];
    62	  const hero = sortedPlayers.filter(player => player.power !== undefined)[0];
    63	  const position = finalPosition(state);
    64	  const latestResolvedEvent = state.resolvedEventHistory
    65	    ?.filter(event => event.season === state.season)
    66	    .at(-1)?.eventId;
    67	
    68	  return {
    69	    season: state.season,
    70	    division: state.m2 === undefined ? 5 : currentUserDivision(state.m2),
    71	    finalPosition: position,
    72	    played: fixtures.length,
    73	    won,
    74	    drawn,
    75	    lost,
    76	    goalsFor,
    77	    goalsAgainst,
    78	    cashChange,
    79	    closingCash: club.cash,
    80	    // Cap-free development plus instant drills retired cap notices entirely;
