    77	/**
    78	 * Cup notes track the club's own run and stop the week it ends. A knocked-out
    79	 * manager does not need a weekly bulletin about a competition they are watching
    80	 * from the outside.
    81	 */
    82	function cupRoundNotes(state: GameState): ManagerNoteViewModel[] {
    83	  const cup = state.m2?.nationalCups.find(candidate => candidate.season === state.season);
    84	  if (cup === undefined || cup.championClubId !== undefined) return [];
    85	  const round = cup.rounds.find(candidate => (
    86	    CUP_SETTLEMENT_WEEKS[candidate.number - 1] === state.week
    87	  ));
    88	  if (round === undefined) return [];
    89	
    90	  const nextRoundWeek = CUP_SETTLEMENT_WEEKS[round.number];
    91	  const nextRoundLabel = nextCupRoundLabel(round.label);
    92	
    93	  if (round.byeClubIds.includes(state.userClubId)) {
    94	    return [{
    95	      id: `note:cup-bye:${round.number}`,
    96	      title: `Manager's Note: Hero Cup bye through the ${round.label}`,
    97	      detail: nextRoundLabel === undefined || nextRoundWeek === undefined
    98	        ? 'You sit this round out and go straight through.'
    99	        : `You sit this round out. Your run starts in Week ${nextRoundWeek} in the ${nextRoundLabel}.`,
   100	    }];
   101	  }
   102	
   103	  const fixture = round.fixtures.find(candidate => (
   104	    candidate.homeClubId === state.userClubId || candidate.awayClubId === state.userClubId
   105	  ));
   106	  if (fixture === undefined) return [];
   107	
   108	  const opponentId = fixture.homeClubId === state.userClubId ? fixture.awayClubId : fixture.homeClubId;
   109	  const opponent = state.clubs.find(club => club.id === opponentId)?.name ?? 'your opponent';
   110	  // Name the ground rather than trailing "at home" after the opponent, which
   111	  // reads as the opponent being the home side.
   112	  const venue = fixture.homeClubId === state.userClubId ? 'our stadium' : 'their stadium';
   113	  const opening = `Playing ${opponent} at ${venue}.`;
   114	  return [{
   115	    id: `note:cup-round:${round.number}`,
   116	    title: `Manager's Note: Hero Cup ${round.label} this week`,
   117	    detail: nextRoundLabel === undefined || nextRoundWeek === undefined
   118	      ? `${opening} Win it and the Hero Cup is yours, the biggest prize money and the biggest crowd of the season.`
   119	      : `${opening} Win and you reach the ${nextRoundLabel} in Week ${nextRoundWeek}, where the prize money and the fans both grow. Lose and your run is over. There is no second chance.`,
   120	  }];
   121	}
