  2644	  const userDivision = divisions?.[state.userClubId];
  2645	  const opponentDivision = divisions?.[cupTie.opponentClubId];
  2646	  if (userDivision === undefined || opponentDivision === undefined) return 0;
  2647	  return userDivision - opponentDivision;
  2648	}
