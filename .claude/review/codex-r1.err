    12	
    13	/**
    14	 * The league table's fixed columns, checked by re-running the arithmetic that
    15	 * chose them rather than by trusting the numbers.
    16	 *
    17	 * Every one of these four was too narrow before, and two were visibly wrapping
    18	 * on a phone: "PTS" broke to "PT" over a lone "S", and Thunder Borough's "+10"
    19	 * broke to "+1" over "0". The cause is the same rem trap the register hit —
    20	 * `w-9` is 31.5pt on native, not 36 — compounded by the reader's text size,
    21	 * which the values are deliberately allowed to follow.
    22	 */
    23	describe('league table column widths', () => {
    24	  it('holds every header at the size cap a fixed column can afford', () => {
    25	    for (const [label, width] of [
    26	      ['#', LEAGUE_COLUMN_WIDTH.position],
    27	      ['P', LEAGUE_COLUMN_WIDTH.played],
    28	      ['GD', LEAGUE_COLUMN_WIDTH.goalDifference],
    29	      ['PTS', LEAGUE_COLUMN_WIDTH.points],
    30	    ] as const) {
    31	      expect(leagueHeaderWidthDemand(label)).toBeLessThanOrEqual(width);
    32	    }
    33	  });
    34	
    35	  it('holds the widest value each column can ever show, at full text scale', () => {
    36	    // The values are not capped: a number the manager is reading is exactly
    37	    // what a larger text size is for. So the column carries the growth instead.
    38	    for (const [value, size, width] of [
    39	      ['10', 'position', LEAGUE_COLUMN_WIDTH.position],
    40	      ['30', 'played', LEAGUE_COLUMN_WIDTH.played],
    41	      ['+40', 'goalDifference', LEAGUE_COLUMN_WIDTH.goalDifference],
    42	      ['54', 'points', LEAGUE_COLUMN_WIDTH.points],
    43	    ] as const) {
    44	      expect(leagueCellWidthDemand(value, size)).toBeLessThanOrEqual(width);
    45	    }
    46	  });
    47	
    48	  it('shows why the old columns fitted in the code and not on the phone', () => {
    49	    // `w-9` is 2.25rem, and a rem is React Native's 14pt — 31.5, not 36.
    50	    const w9 = 2.25 * 14;
    51	    expect(w9).toBeCloseTo(31.5);
    52	
    53	    // At ordinary text size both of the wrapping cells DO fit, which is why
    54	    // this looked correct in review and broke in the hand. The reader's text
    55	    // size is the missing term: xxLarge scales every font by 1.235.
    56	    const xxLarge = 1.235;
    57	    const goalDifference = LEAGUE_CELL_ADVANCE_EM['+10'] * LEAGUE_CELL_FONT_SIZE.goalDifference;
    58	    const pointsHeader = LEAGUE_HEADER_ADVANCE_EM.PTS * LEAGUE_HEADER_FONT_SIZE;
    59	
    60	    expect(goalDifference).toBeLessThan(w9);
    61	    expect(pointsHeader).toBeLessThan(w9);
    62	    expect(goalDifference * xxLarge).toBeGreaterThan(w9);
    63	    expect(pointsHeader * xxLarge).toBeGreaterThan(w9);
    64	
    65	    // And both clear their new columns at the full 1.6 the app allows.
    66	    expect(goalDifference * CELL_MAX_FONT_MULTIPLIER)
    67	      .toBeLessThanOrEqual(LEAGUE_COLUMN_WIDTH.goalDifference);
    68	    expect(pointsHeader * HEADER_MAX_FONT_MULTIPLIER)
    69	      .toBeLessThanOrEqual(LEAGUE_COLUMN_WIDTH.points);
    70	  });
    71	
    72	  it('caps headers tighter than cells, and both below the app maximum', () => {
    73	    // An abbreviation labelling a fixed column cannot grow without shoving its
    74	    // neighbour off the row; the sentence it stands for is on the InfoTip.
    75	    expect(HEADER_MAX_FONT_MULTIPLIER).toBeLessThan(CELL_MAX_FONT_MULTIPLIER);
    76	    expect(CELL_MAX_FONT_MULTIPLIER).toBeLessThanOrEqual(1.6);
    77	    // Above the xxLarge multiplier (1.235), so ordinary large text is unaffected.
    78	    expect(HEADER_MAX_FONT_MULTIPLIER).toBeGreaterThan(1.235);
    79	  });
    80	});
