  2753	/**
  2754	 * The save-upgrade ladder, ordered by ascending `to`.
  2755	 *
  2756	 * Schema 2 deliberately has no schema-1 rung: the honest division ladder
  2757	 * changes every persisted rival. Development policy permits the break, while
  2758	 * refusing here prevents a half-old/half-new pyramid from loading silently.
  2759	 *
  2760	 * To add a version: raise `GAME_SCHEMA_VERSION` in `src/game/types.ts` and append
  2761	 * `{ to: <new version>, up }` here. Anything the new schema requires must be
  2762	 * synthesised by `up`, because an old save will not carry it.
  2763	 */
  2764	const GAME_STATE_MIGRATIONS: readonly GameStateMigration[] = [
  2765	  {
  2766	    to: 3,
  2767	    // Player requests added `loyalty`, `awayWeeks` and `playerRequests`, and
  2768	    // every one of them is optional — loyalty is derived from the career seed
  2769	    // whenever the field is absent (`src/game/loyalty.ts`), and the request
  2770	    // state is defaulted during reconciliation. A schema-2 save is therefore
  2771	    // already a valid schema-3 save and needs nothing synthesised.
  2772	    //
  2773	    // The rung still has to exist: the ladder refuses a missing boundary
  2774	    // outright, so without it every save written before this feature would fail
  2775	    // to load rather than upgrade.
  2776	    up: state => state,
  2777	  },
  2778	  {
  2779	    to: 4,
  2780	    up: migrateSchema3To4,
  2781	  },
  2782	  {
  2783	    to: 5,
  2784	    up: migrateSchema4To5,
  2785	  },
  2786	];
