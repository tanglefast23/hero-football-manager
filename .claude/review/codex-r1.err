  2613	    if (tiersAbove >= -1) return 'cupWinSlight';
  2614	    return 'cupWinRoutine';
  2615	  }
  2616	  if (tiersAbove >= 1) return 'cupLossStrong';
  2617	  if (tiersAbove === 0) return 'cupLossEven';
  2618	  return 'cupLossWeak';
  2619	}
