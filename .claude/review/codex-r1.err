    29	  describe('parity', () => {
    30	    it('two fully automatic zero-input runs are byte-identical', () => {
    31	      const a = runMatch(42, ROVERS, UNITED);
    32	      const b = runMatch(42, ROVERS, UNITED);
    33	      expect(JSON.stringify(a)).toBe(JSON.stringify(b));
    34	    });
    35	  });
    36	
    37	  describe('causal divergence', () => {
    38	    it('a single well-timed tap changes the actual match outcome (score or shot count), not just event bytes', () => {
    39	      let causal = false;
    40	      let evidence = '';
    41	      for (let seed = 1; seed <= 60 && !causal; seed++) {
    42	        const base = runMatch(seed, ROVERS, UNITED, [], TAP_HOME);
    43	        const ready = base.events.find(e => e.kind === 'POWER_READY' && (e as { player: number }).player < 11) as
    44	          | { t: number; player: number } | undefined;
    45	        if (!ready) continue;
    46	        // Taps are only honored while that hero is in the Zone (powerTick), so
    47	        // one tick after zone entry is the earliest legal, well-timed tap.
    48	        const taps: MatchInput[] = [{ tick: ready.t + 1, kind: 'POWER_TAP', player: ready.player }];
    49	        const tapped = runMatch(seed, ROVERS, UNITED, taps, TAP_HOME);
    50	        if (tapped.score[0] !== base.score[0] || tapped.score[1] !== base.score[1] || shotCount(tapped) !== shotCount(base)) {
    51	          causal = true;
    52	          evidence = `seed ${seed}: base score [${base.score}] shots ${shotCount(base)} vs tapped score [${tapped.score}] shots ${shotCount(tapped)}`;
    53	        }
    54	      }
    55	      console.log('CAUSAL DIVERGENCE evidence:', evidence || '(none found in seeds 1-60)');
    56	      expect(causal).toBe(true);
    57	    }, 30000);
    58	  });
    59	
    60	  describe('golden replay', () => {
    61	    it('full event payloads, score, and a state fingerprint are locked for a taped envelope', () => {
    62	      // Discover a natural home Zone entry on seed 42 to script one legal tap.
    63	      // Rigging powerState directly (as the other gates do) would not survive a
    64	      // replay: the envelope only carries seed + teams + inputs + opts, never
    65	      // ad hoc state mutation, so the taped match must be produced entirely
    66	      // through the replayable pathway (createMatch + queueInput + tick).
    67	      const discovery = runMatch(42, ROVERS, UNITED, [], TAP_HOME);
    68	      const ready = discovery.events.find(e => e.kind === 'POWER_READY' && (e as { player: number }).player < 11) as
    69	        | { t: number; player: number } | undefined;
    70	      expect(ready).toBeDefined();
    71	      const scriptedTap: MatchInput = { tick: ready!.t + 1, kind: 'POWER_TAP', player: ready!.player };
    72	
    73	      const m = createMatch(42, ROVERS, UNITED, TAP_HOME);
    74	      queueInput(m, scriptedTap);
    75	      const checkpoints = [500, 1000, 1500, 2000];
    76	      const fingerprints: Record<number, ReturnType<typeof fingerprintAt>> = {};
    77	      while (m.phase !== 'fulltime') {
    78	        tick(m);
    79	        if (checkpoints.includes(m.tick)) fingerprints[m.tick] = fingerprintAt(m);
    80	      }
    81	
    82	      const env = envelopeFrom(m);
    83	      expect(env.seed).toBe(42);
    84	      expect(env.engineVersion).toBe(ENGINE_VERSION);
    85	      expect(env.inputs).toEqual([scriptedTap]);
    86	
    87	      const replayed = runReplay(env);
    88	      expect(replayed.score).toEqual(m.score);
    89	      expect(replayed.events).toEqual(m.events);
    90	
    91	      expect({ score: m.score, events: m.events, fingerprints }).toMatchSnapshot();
    92	    }, 15000);
    93	  });
    94	});
