  2757	/**
  2758	 * Every button here uses a local `pressed` state with a plain-array `style`.
  2759	 * A function-form `style` on a Pressable renders zero-height and untappable on
  2760	 * iOS only — and this is the one screen where a dead button means a dead game.
  2761	 */
  2762	function BootFailureButton({
  2763	  label,
  2764	  accessibilityLabel,
  2765	  onPress,
  2766	  tone,
  2767	}: {
  2768	  label: string;
  2769	  accessibilityLabel: string;
  2770	  onPress: () => void;
  2771	  tone: 'primary' | 'paper';
  2772	}) {
  2773	  const [pressed, setPressed] = useState(false);
  2774	  return (
  2775	    <Pressable
  2776	      accessibilityRole="button"
  2777	      accessibilityLabel={accessibilityLabel}
  2778	      onPress={onPress}
  2779	      onPressIn={() => setPressed(true)}
  2780	      onPressOut={() => setPressed(false)}
  2781	      className={tone === 'primary'
  2782	        ? 'mt-5 min-h-12 items-center justify-center border-2 border-b-4 border-ink bg-blue px-4'
  2783	        : 'mt-3 min-h-12 items-center justify-center border-2 border-b-4 border-stamp bg-paper px-4'}
  2784	      style={[{ transform: [{ translateY: pressed ? 2 : 0 }] }]}
  2785	    >
  2786	      <Text className={tone === 'primary'
  2787	        ? 'font-pixel text-sm uppercase text-paper'
  2788	        : 'font-pixel text-sm uppercase text-stamp'}
  2789	      >
  2790	        {label}
  2791	      </Text>
  2792	    </Pressable>
  2793	  );
  2794	}
  2795	
  2796	function BootFailure({
  2797	  message,
  2798	  onRetry,
  2799	  onStartFresh,
  2800	  onExportRaw,
  2801	  onRestoreBackup,
  2802	}: {
  2803	  message: string;
  2804	  onRetry: () => void;
  2805	  onStartFresh?: () => void;
  2806	  onExportRaw?: () => void;
  2807	  onRestoreBackup?: { season: number; week: number; onRestore: () => void };
  2808	}) {
  2809	  const [confirmingDiscard, setConfirmingDiscard] = useState(false);
  2810	  // Armed is a dangerous state to leave lying around: the save is one tap from
  2811	  // deletion, and the arming tap may have been a misfire. It expires on its own.
  2812	  useEffect(() => {
  2813	    if (!confirmingDiscard) return undefined;
  2814	    const timer = setTimeout(() => setConfirmingDiscard(false), 5_000);
  2815	    return () => clearTimeout(timer);
  2816	  }, [confirmingDiscard]);
  2817	  return (
  2818	    <SafeAreaView className="flex-1 items-center justify-center bg-ink px-6">
  2819	      <View className="w-full border-2 border-stamp bg-paper p-5">
  2820	        <Text className="font-pixel text-lg uppercase text-stamp">We could not open your club</Text>
  2821	        <Text className="mt-3 text-sm leading-5 text-ink/70">Your saved career has not been changed. Try again.</Text>
  2822	        <Text className="mt-2 text-xs leading-4 text-ink/50">Technical detail: {message}</Text>
  2823	        <BootFailureButton
  2824	          tone="primary"
  2825	          label="Retry"
  2826	          accessibilityLabel="Retry opening club files"
  2827	          onPress={() => {
  2828	            setConfirmingDiscard(false);
  2829	            onRetry();
  2830	          }}
  2831	        />
  2832	        {onRestoreBackup !== undefined && (
  2833	          <BootFailureButton
  2834	            tone="paper"
  2835	            label={`Restore season ${onRestoreBackup.season} · week ${onRestoreBackup.week}`}
  2836	            accessibilityLabel={`Restore the backup saved at season ${onRestoreBackup.season}, week ${onRestoreBackup.week}`}
  2837	            onPress={onRestoreBackup.onRestore}
  2838	          />
  2839	        )}
  2840	        {onExportRaw !== undefined && (
  2841	          <BootFailureButton
  2842	            tone="paper"
  2843	            label="Export raw save"
  2844	            accessibilityLabel="Export the unchanged raw saved career"
  2845	            onPress={onExportRaw}
  2846	          />
  2847	        )}
  2848	        {onStartFresh !== undefined && (
  2849	          <BootFailureButton
  2850	            tone="paper"
  2851	            label={confirmingDiscard ? 'Tap again to delete' : 'Delete save · start fresh'}
  2852	            accessibilityLabel={confirmingDiscard
  2853	              ? 'Confirm: delete the saved career and start fresh'
  2854	              : 'Delete the saved career and start fresh'}
  2855	            onPress={() => (confirmingDiscard ? onStartFresh() : setConfirmingDiscard(true))}
  2856	          />
  2857	        )}
  2858	      </View>
  2859	    </SafeAreaView>
  2860	  );
  2861	}
  2862	
  2863	/**
  2864	 * Persistent, non-dismissible: a career that is not reaching disk must keep
  2865	 * saying so. `blocked` means week advancement is paused, so the retry is the
  2866	 * designed way out rather than an optional extra.
  2867	 */
  2868	function SaveWarningBanner({
  2869	  message,
  2870	  blocked,
  2871	  onRetry,
  2872	}: {
  2873	  message: string;
  2874	  blocked: boolean;
  2875	  onRetry: () => void;
  2876	}) {
  2877	  // top-0 sat the alert text under the notch/Dynamic Island; pad by the real
  2878	  // inset so the first line is always readable.
  2879	  const insets = useSafeAreaInsets();
  2880	  return (
  2881	    <View
  2882	      accessible
  2883	      accessibilityRole="alert"
  2884	      accessibilityLabel={`Save problem: ${message}`}
  2885	      className="absolute inset-x-0 top-0 border-b-4 border-stamp bg-red-light px-4 py-3"
  2886	      style={{ paddingTop: insets.top + 12 }}
  2887	    >
  2888	      <Text className="font-pixel text-sm uppercase text-stamp">Your club is not saving</Text>
  2889	      <Text className="mt-1 text-xs leading-4 text-ink/70">{message}</Text>
  2890	      {blocked && (
  2891	        <BootFailureButton
  2892	          tone="primary"
  2893	          label="Try saving again"
  2894	          accessibilityLabel="Try saving your career again"
  2895	          onPress={onRetry}
  2896	        />
  2897	      )}
  2898	    </View>
  2899	  );
  2900	}
  2901	
  2902	function FeedbackNotice({
  2903	  message,
  2904	  tone,
  2905	  onDismiss,
  2906	}: {
  2907	  message: string;
  2908	  tone: 'error' | 'info' | 'success';
  2909	  onDismiss: () => void;
  2910	}) {
  2911	  useEffect(() => {
  2912	    if (tone === 'error') return undefined;
  2913	    const timer = setTimeout(onDismiss, 4_000);
  2914	    return () => clearTimeout(timer);
  2915	  }, [message, onDismiss, tone]);
  2916	
  2917	  const palette = tone === 'success'
  2918	    ? 'border-pitch-dark bg-pitch-light'
  2919	    : tone === 'info'
  2920	      ? 'border-blue-dark bg-blue-light'
  2921	      : 'border-stamp bg-red-light';
  2922	  const symbol = tone === 'success' ? '✓' : tone === 'info' ? 'i' : '!';
  2923	  return (
  2924	    <Pressable
  2925	      accessibilityRole={tone === 'error' ? 'alert' : 'button'}
  2926	      accessibilityLiveRegion={tone === 'error' ? 'assertive' : 'polite'}
  2927	      accessibilityLabel={feedbackNoticeAccessibilityLabel(message)}
  2928	      onPress={onDismiss}
  2929	      className={`absolute left-4 right-4 top-16 border-2 px-4 py-3 shadow-lg shadow-black/40 ${palette}`}
  2930	    >
  2931	      <View className="flex-row items-start gap-3">
  2932	        <Text className="font-mono text-base font-bold text-ink">{symbol}</Text>
  2933	        <Text className="flex-1 text-sm font-bold text-ink">{message}</Text>
  2934	        <Text className="font-mono text-sm text-ink/50">×</Text>
  2935	      </View>
  2936	    </Pressable>
  2937	  );
  2938	}
  2939	
  2940	function feedbackNoticeAccessibilityLabel(message: string): string {
  2941	  const trimmed = message.trim();
  2942	  const sentence = /[.!?]$/.test(trimmed) ? trimmed : `${trimmed}.`;
  2943	  return `${sentence} Tap to dismiss.`;
  2944	}

