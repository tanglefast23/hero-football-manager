     1	import { GAME_SCHEMA_VERSION, type GameState } from '../game/types';
     2	import { ENGINE_VERSION } from '../sim/match';
     3	import { InvalidSaveFileError, UnsupportedGameSchemaError } from './errors';
     4	import { parseStoredGameState, serializeGameState } from './game-state-codec';
     5	import type { RawStoredCareer } from './career-repository';
     6	
     7	/**
     8	 * Marks a file as one of ours. A foreign JSON file is refused on this field
     9	 * alone, before anything reads the career out of it.
    10	 */
    11	export const SAVE_FILE_FORMAT = 'hero-football-manager-career';
    12	
    13	/**
    14	 * The envelope's own version, separate from the game schema version it carries:
    15	 * the wrapper can gain fields without touching the save shape, and vice versa.
    16	 */
    17	export const SAVE_FILE_FORMAT_VERSION = 1;
    18	
    19	/**
    20	 * What an exported file contains. Self-describing on purpose — an import decides
    21	 * whether it can read the file from the envelope, without having to guess from
    22	 * the state inside it.
    23	 */
    24	export interface CareerSaveFileEnvelope {
    25	  readonly format: typeof SAVE_FILE_FORMAT;
    26	  readonly formatVersion: number;
    27	  /** The save schema the career was written at; drives the migration ladder. */
    28	  readonly gameSchemaVersion: number;
    29	  /** The match engine that wrote it. Recorded, never enforced — see below. */
    30	  readonly engineVersion: string;
    31	  readonly state: unknown;
    32	}
    33	
    34	export interface DecodedCareerSaveFile {
    35	  readonly state: GameState;
    36	  /** The schema the file declared, i.e. before the migration ladder ran. */
    37	  readonly gameSchemaVersion: number;
    38	  /**
    39	   * The engine version the file declared. A career is not a replay: it stores
    40	   * outcomes, not the RNG stream that produced them, so an engine change cannot
    41	   * invalidate it. Surfaced for diagnostics, never a reason to refuse.
    42	   */
    43	  readonly engineVersion: string;
    44	}
    45	
    46	/** The file-system half of an export, injected so persistence keeps no Expo import. */
    47	export interface CareerSaveExportOptions {
    48	  /** The career to write out; the live in-memory state, not the stored row. */
    49	  state: GameState;
    50	  /** Writes UTF-8 text under `fileName` and returns a locator for it (a URI). */
    51	  writeFile: (fileName: string, contents: string) => Promise<string>;
    52	  /** Hands the written file to the user — share sheet on iOS, download on web. */
    53	  shareFile?: (uri: string) => Promise<void>;
    54	}
    55	
    56	export interface CareerSaveExportResult {
    57	  readonly fileName: string;
    58	  readonly uri: string;
    59	  /** False when no `shareFile` was injected, so the file exists but was not offered. */
    60	  readonly shared: boolean;
    61	}
    62	
    63	export interface RawCareerSaveExportOptions {
    64	  raw: RawStoredCareer;
    65	  writeFile: (fileName: string, contents: string) => Promise<string>;
    66	  shareFile?: (uri: string) => Promise<void>;
    67	}
    68	
    69	/** The file-system half of an import, plus the one write it is allowed to make. */
    70	export interface CareerSaveImportOptions {
    71	  /** Reads the picked file, or resolves null when the player cancelled. */
    72	  readFile: () => Promise<string | null>;
    73	  /**
    74	   * Replaces the live save. Called only after the file has fully validated, so a
    75	   * corrupt or foreign file leaves the existing career untouched.
  2800	 * A version newer than this build is refused outright: that is a downgrade, and
  2801	 * nothing here can invent the meaning of a field written by a future version. A
  2802	 * missing rung is refused for the same reason — silently accepting it would hand
  2803	 * a half-upgraded save to the validator and report a corrupt save instead of the
  2804	 * real cause.
  2805	 */
  2806	export function migrateStoredGameState(value: unknown): unknown {
  2807	  let current = value;
  2808	  let version = readSchemaVersion(current, true);
  2809	  if (version > GAME_SCHEMA_VERSION) {
  2810	    throw new UnsupportedGameSchemaError(version, GAME_SCHEMA_VERSION);
  2811	  }
  2812	  while (version < GAME_SCHEMA_VERSION) {
  2813	    const step = GAME_STATE_MIGRATIONS.find(migration => migration.to === version + 1);
  2814	    if (step === undefined) {
  2815	      throw new UnsupportedGameSchemaError(version, GAME_SCHEMA_VERSION);
  2816	    }
  2817	    if (!isRecord(current)) {
  2818	      throw new CorruptCareerSaveError(`schema ${version} save is not an object`);
  2819	    }
  2820	    const upgraded = step.up(current);
  2821	    if (!isRecord(upgraded)) {
  2822	      throw new CorruptCareerSaveError(`schema migration to ${step.to} produced a non-object`);
  2823	    }
  2824	    current = { ...upgraded, schemaVersion: step.to };
  2825	    version = step.to;
  2826	  }
  2827	  return current;
  2828	}
  2829	
  2830	function assertSupportedSchema(value: unknown, stored: boolean): void {
  2831	  const version = readSchemaVersion(value, stored);
  2832	  if (version !== GAME_SCHEMA_VERSION) {
  2833	    throw new UnsupportedGameSchemaError(version, GAME_SCHEMA_VERSION);
  2834	  }
  2835	}
  2836	
  2837	function isRecord(value: unknown): value is Record<string, unknown> {
  2838	  return typeof value === 'object' && value !== null && !Array.isArray(value);
  2839	}
  2840	
  2841	function formatIssues(issues: z.core.$ZodIssue[]): string {
  2842	  return issues
  2843	    .slice(0, 3)
  2844	    .map((issue) => `${issue.path.join('.') || 'state'} ${issue.message}`)
  2845	    .join('; ');
  2846	}
