   214	/**
   215	 * Where the club finished the season it just played.
   216	 *
   217	 * Ordered by `compareStandings` — the same comparator `leagueStandings` sorts
   218	 * with, imported rather than restated. The transition promotes and relegates
   219	 * off that table while the awards ceremony prices its prize off this number, so
   220	 * the two must be one rule. Restating the terms here is what let them drift:
   221	 * this function once tiebroke with `localeCompare` where the table used plain
   222	 * `<`/`>`, and on an exact points, goal-difference and goals-for tie across the
   223	 * promotion cutoff the ceremony could frame a promotion that never happened.
   224	 */
   225	function finalPosition(state: GameState): number {
   226	  const rows = state.clubs.map(club => {
   227	    let points = 0;
   228	    let goalDifference = 0;
   229	    let goalsFor = 0;
   230	    for (const fixture of state.fixtures) {
   231	      if (fixture.season !== state.season || fixture.status !== 'played' || fixture.score === undefined) continue;
   232	      if (fixture.homeClubId !== club.id && fixture.awayClubId !== club.id) continue;
   233	      const home = fixture.homeClubId === club.id;
   234	      const scored = home ? fixture.score.homeGoals : fixture.score.awayGoals;
   235	      const conceded = home ? fixture.score.awayGoals : fixture.score.homeGoals;
   236	      goalDifference += scored - conceded;
   237	      goalsFor += scored;
   238	      points += scored > conceded ? 3 : scored === conceded ? 1 : 0;
   239	    }
   240	    return { clubId: club.id, points, goalDifference, goalsFor };
   241	  }).sort(compareStandings);
   242	  const index = rows.findIndex(row => row.clubId === state.userClubId);
   243	  if (index >= 0) return index + 1;
   244	  return rows.length;
   245	}
