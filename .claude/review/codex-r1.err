   104	function grantLabel(
   105	  definition: PlayerRequestDefinition,
   106	  costAmount: number | undefined,
   107	  difficulty: DifficultyMode,
   108	): string {
   109	  const cost = definition.cost;
   110	  if (cost.kind === 'MONEY_PLAYER' || cost.kind === 'MONEY_SQUAD') {
   111	    return `−${(costAmount ?? 0).toLocaleString('en-GB')}`;
   112	  }
   113	  if (cost.kind === 'ABSENCE') {
   114	    const weeks = absenceWeeksFor(cost.weeks, difficulty);
   115	    return `Out ${weeks} ${weeks === 1 ? 'week' : 'weeks'}`;
   116	  }
   117	  if (cost.kind === 'CONDITION_SQUAD') return `Squad −${cost.amount} condition`;
   118	  if (cost.kind === 'DRILL_PLAYER') {
   119	    return `Their drills ×${cost.multiplierPercent / 100} for ${cost.weeks} weeks`;
   120	  }
   121	  return `Squad drills ×${cost.multiplierPercent / 100} for ${cost.weeks} weeks`;
   122	}
