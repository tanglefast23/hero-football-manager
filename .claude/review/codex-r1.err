   151	
   152	export function clubLegacyViewModel(state: GameState): ClubLegacyViewModel {
   153	  const reconciled = reconcilePendingClubLegends(state);
   154	  const legend = nextPendingClubLegend(reconciled);
   155	  if (legend === undefined) throw new Error('there is no pending club-legend decision');
   156	  const pendingCount = reconciled.pendingLegacyPlayerIds?.length ?? 0;
   157	  // Newest first, and never the legend whose decision is on this screen: he is
   158	  // the panel above, and listing him twice reads as two different men.
   159	  const formerPlayers = (state.retiredPlayers ?? [])
   160	    .filter(player => player.clubId === state.userClubId && player.id !== legend.id)
   161	    .slice()
   162	    .reverse();
   163	  return {
   164	    seasonLabel: `Season ${state.season}`,
   165	    queueLabel: pendingCount === 1 ? 'Final legacy decision' : `${pendingCount} legacy decisions remain`,
   166	    playerId: legend.id,
   167	    playerName: legend.name,
   168	    role: legend.role,
   169	    lookId: legend.lookId,
   170	    archetype: legend.archetype ?? 'All-Rounder',
   171	    personality: legend.personality ?? 'Professional',
   172	    fame: legend.fame ?? 0,
   173	    seasonsAtClub: legend.seasonsAtClub ?? 0,
   174	    isHero: legend.power !== undefined,
   175	    // Two options, and neither is the safe one. The coach spends a wage the
   176	    // club may not have; the farewell spends the only chance to have him.
   177	    choices: [
   178	      {
   179	        id: 'coach-candidate',
   180	        label: 'Join the staff',
   181	        detail: `${legend.name} begins a new career on the touchline, carrying hard-earned club knowledge into every session.`,
   182	        outcome: 'Adds a loyalty-discounted candidate to the coach market.',
   183	      },
   184	      {
   185	        id: 'farewell',
   186	        label: 'Let him go',
   187	        detail: `${legend.name} takes the applause, shakes every hand in the building and walks out of it. Some players are not coaches, and the club has no wage spare to find out.`,
   188	        outcome: 'No coach, no cost. The offer is not made twice.',
   189	      },
