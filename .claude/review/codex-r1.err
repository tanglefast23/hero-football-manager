  2579	const BLOWOUT_MARGIN = 3;
  2580	
  2581	/**
  2582	 * Which of the gaffer's pools this afternoon draws from.
  2583	 *
  2584	 * Cup ties band on the division gap frozen into the draw rather than on the
  2585	 * margin or on live squad ratings. A knockout is remembered for who it was
  2586	 * against — beating a club two tiers up is the story whether it finished 1-0 or
  2587	 * 4-0 — and the seeded divisions are the same numbers `cupGiantKillingCelebration`
  2588	 * already reads, so the gaffer and Bert cannot disagree about how big the upset
  2589	 * was. Cups drawn before the seed map existed fall through as a level tie,
  2590	 * which is the reading that claims least.
  2591	 */
  2592	function coachLinePool(
  2593	  state: GameState,
  2594	  result: {
