     1	import { Text, type TextProps } from 'react-native';
     2	
     3	/**
     4	 * The three type voices from docs/11-art-style.md, in one place.
     5	 *
     6	 * React Native does not inherit `fontFamily` through a `<View>`, so every text
     7	 * node has to name its own face. A bare `<Text>` therefore renders in SF Pro /
     8	 * Roboto — the OS font, inside a pixel-art game. This component exists so a
     9	 * call site picks a *voice* instead of remembering a class name.
    10	 *
    11	 * - `display` (default) — Silkscreen **Bold**. Buttons, labels, headings,
    12	 *   eyebrows, chips, table headers. Per the art bible this is the game's
    13	 *   default voice, which is why it is the default variant here.
    14	 * - `data` — Silkscreen Regular. Money, stats, scores, table cells: anything
    15	 *   that has to line up in a column.
    16	 * - `body` — no pixel face at all, i.e. the platform sans. Long prose is
    17	 *   deliberately *not* pixel type ("pixel fonts are exhausting to read").
    18	 *
    19	 * Never add `font-bold` on top of these. Silkscreen ships one weight per file,
    20	 * so a bold request on the regular cut produces synthetic faux-bold, which
    21	 * smears a 1-bit bitmap font. `display` already *is* the bold cut.
    22	 */
    23	export type PixelTextVariant = 'display' | 'data' | 'body';
    24	
    25	const VARIANT_CLASS: Record<PixelTextVariant, string> = {
    26	  display: 'font-pixel',
    27	  data: 'font-mono',
    28	  body: '',
    29	};
    30	
    31	export type PixelTextProps = TextProps & {
    32	  variant?: PixelTextVariant;
    33	  className?: string;
    34	};
    35	
    36	/**
    37	 * The variant class is emitted *before* the caller's className so a call site
    38	 * can still override the face for a one-off (NativeWind resolves conflicting
    39	 * utilities last-wins). The font is applied via className and never via
    40	 * `style`, because mixing the two for one visual property lets either win
    41	 * unpredictably on native.
    42	 */
    43	export function PixelText({ variant = 'display', className, ...props }: PixelTextProps) {
    44	  const face = VARIANT_CLASS[variant];
    45	  const merged = className === undefined || className.length === 0
    46	    ? face
    47	    : face.length === 0
    48	      ? className
    49	      : `${face} ${className}`;
    50	
    51	  return <Text {...props} className={merged.length === 0 ? undefined : merged} />;
    52	}
     1	/**
     2	 * How wide each fixed column of the league table has to be, in points.
     3	 *
     4	 * Same derivation, and the same two traps, as `squad-register-columns.ts`:
     5	 *
     6	 * 1. NativeWind resolves `1rem` to React Native's 14pt, so `w-9` is 31.5pt and
     7	 *    `w-7` is 24.5 — not the 36 and 28 the class names imply. All four columns
     8	 *    were sized by those names and all four were too narrow.
     9	 * 2. Text grows with the reader's iOS text size, up to 1.6 by default.
    10	 *
    11	 * Measured on Joe's phone at ordinary text size, two were already wrapping:
    12	 * "PTS" broke to "PT" over a lone "S" (needs 29.8pt of a 31.5pt column, and
    13	 * loses the margin to any rounding), and a "+10" goal difference broke to "+1"
    14	 * over "0" (needs exactly 31.5 of 31.5). The club name is the only flexible
    15	 * column and pays for the fix; it has room to spare.
    16	 *
    17	 * `league-table-columns.test.ts` re-runs the arithmetic below, so a width
    18	 * cannot quietly stop fitting again.
    19	 */
    20	
    21	/**
    22	 * Silkscreen Regular advances in em, read out of the shipped TTF's `hmtx`
    23	 * table. Digits are 0.75em, "+"/"-" 0.75em, and uppercase varies — so these
    24	 * are per-string totals for exactly the strings the table draws.
    25	 */
    26	export const LEAGUE_HEADER_ADVANCE_EM: Readonly<Record<string, number>> = {
    27	  '#': 0.875,
    28	  P: 0.75,
    29	  W: 1.0,
    30	  D: 0.75,
    31	  L: 0.75,
    32	  GD: 1.5,
    33	  PTS: 2.125,
    34	};
    35	
    36	/** The widest value each column can ever be asked to draw. */
    37	export const LEAGUE_CELL_ADVANCE_EM: Readonly<Record<string, number>> = {
    38	  // Ten clubs to a division, so a two-digit position is the ceiling.
    39	  '10': 1.5,
    40	  // Eighteen league matches in a season; "30" leaves room for a longer format.
    41	  '30': 1.5,
    42	  // Goal difference is the only signed column, and the one that was wrapping.
    43	  '+10': 2.25,
    44	  '+40': 2.25,
    45	  // Eighteen wins is 54 points, so two digits with headroom for three.
    46	  '54': 1.375,
    47	};
    48	
    49	/** `text-sm`, which NativeWind resolves to 0.875rem = 12.25pt. */
    50	export const LEAGUE_HEADER_FONT_SIZE = 12.25;
    51	
    52	/**
    53	 * Cell sizes by column. Position and points are `text-base` (1rem = 14pt)
    54	 * because they are the two numbers a manager scans for; played and goal
    55	 * difference are `text-sm`.
    56	 */
    57	export const LEAGUE_CELL_FONT_SIZE = {
    58	  position: 14,
    59	  played: 12.25,
    60	  won: 12.25,
    61	  drawn: 12.25,
    62	  lost: 12.25,
    63	  goalDifference: 12.25,
    64	  points: 14,
    65	} as const;
    66	
    67	/**
    68	 * How far a header may grow with the reader's text size.
    69	 *
    70	 * Tighter than the cells for the reason the register gives: an abbreviation
    71	 * labelling a fixed column cannot grow without pushing its neighbour off the
    72	 * row, and what it stands for is on its InfoTip at any size. 1.25 clears the
    73	 * xxLarge multiplier (1.235), so ordinary large text renders unchanged.
    74	 */
    75	export const HEADER_MAX_FONT_MULTIPLIER = 1.25;
    76	
    77	/**
    78	 * The values are allowed the app's full range. A number the manager is reading
    79	 * is exactly what a larger text size is for, so the column carries the growth
    80	 * rather than the reader losing the number.
    81	 */
    82	export const CELL_MAX_FONT_MULTIPLIER = 1.6;
    83	
    84	/** Clear space between a column and the one beside it, at the size cap. */
    85	export const COLUMN_MIN_GUTTER = 4;
    86	
    87	/**
    88	 * Fixed column widths, each the larger of its header demand and its widest
    89	 * value demand, rounded up onto the four-point grid.
    90	 */
    91	export const LEAGUE_COLUMN_WIDTH = {
    92	  // Won, drawn and lost appear only on the full table screen. Same demand as
    93	  // played: a two-digit count at full text scale.
    94	  won: 36,
    95	  drawn: 36,
    96	  lost: 36,
    97	  // "10" at full text scale wants 37.6.
    98	  position: 40,
    99	  // "30" wants 33.4.
   100	  played: 36,
   101	  // "+40" wants 48.1 — the column that was visibly breaking.
   102	  goalDifference: 52,
   103	  // Header-bound, not value-bound: "PTS" at the 1.25 cap wants 36.5 against
   104	  // "54"'s 34.8. The only column here whose label is wider than its numbers.
   105	  points: 40,
   106	} as const;
   107	
   108	export type LeagueColumn = keyof typeof LEAGUE_COLUMN_WIDTH;
   109	
   110	/** Width a header needs at its size cap, plus the gutter to its neighbour. */
   111	export function leagueHeaderWidthDemand(label: string): number {
   112	  const advanceEm = LEAGUE_HEADER_ADVANCE_EM[label];
   113	  if (advanceEm === undefined) {
   114	    throw new Error(`No measured Silkscreen advance for the header "${label}"`);
   115	  }
   116	  return advanceEm * LEAGUE_HEADER_FONT_SIZE * HEADER_MAX_FONT_MULTIPLIER + COLUMN_MIN_GUTTER;
   117	}
   118	
   119	/** Width a value needs at the reader's largest text size, plus the gutter. */
   120	export function leagueCellWidthDemand(value: string, column: LeagueColumn): number {
   121	  const advanceEm = LEAGUE_CELL_ADVANCE_EM[value];
   122	  if (advanceEm === undefined) {
   123	    throw new Error(`No measured Silkscreen advance for the value "${value}"`);
   124	  }
   125	  return advanceEm * LEAGUE_CELL_FONT_SIZE[column] * CELL_MAX_FONT_MULTIPLIER + COLUMN_MIN_GUTTER;
   126	}
