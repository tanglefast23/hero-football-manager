  2345	 */
  2346	const SCHEMA_3_FACILITY_PRICES = {
  2347	  'training-pitch': { build: 8_000, upgrades: [8_000, 12_000] },
  2348	  gym: { build: 7_000, upgrades: [7_000, 10_500] },
  2349	  'tech-center': { build: 9_000, upgrades: [9_000, 13_500] },
  2350	  'shooting-range': { build: 7_500, upgrades: [7_500, 11_250] },
  2351	  'keeper-court': { build: 7_500, upgrades: [7_500, 11_250] },
  2352	  'medical-bay': { build: 10_000, upgrades: [10_000, 15_000] },
  2353	  dorm: { build: 6_000, upgrades: [6_000, 9_000] },
  2354	  'scout-office': { build: 6_000, upgrades: [6_000, 9_000] },
  2355	  'coaching-office': { build: 6_500, upgrades: [6_500, 9_750] },
  2356	  'youth-field': { build: 12_000, upgrades: [12_000, 18_000] },
  2357	  'fan-shop': { build: 5_000, upgrades: [5_000, 7_500] },
  2358	  'stadium-stand': { build: 15_000, upgrades: [15_000, 22_500] },
  2359	} as const;
  2360	
  2361	function migrateSchema3To4(state: Record<string, unknown>): Record<string, unknown> {
  2362	  assertUncontaminatedSchema3(state);
  2363	  const season = migrationPositiveInteger(state.season, 'season');
  2364	  const week = migrationPositiveInteger(state.week, 'week');
  2365	  const phase = migrationPhase(state.phase);
