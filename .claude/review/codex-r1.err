   331	      facilityCount: number;
   332	      /** merchIncomeBonusPercent at settlement; 0 if none. */
   333	      adjacencyPercent: number;
   334	      /** floor(base × multiplierTimes × adjacencyPercent / 100); 0 if none. */
   335	      adjacencyAmount: number;
