     2	  testEnvironment: 'node',
     3	  roots: ['<rootDir>/src'],
     4	  // .tsx too, or a component test would be collected by nothing and silently
     5	  // never run.
     6	  testMatch: ['**/__tests__/**/*.test.@(ts|tsx)'],
     7	  // Transpile-only (no type-checking during the test run) so the acceptance
     8	  // gates parallelize across workers without each one re-typechecking every
     9	  // file it imports. The type gate is npx tsc --noEmit, run separately in CI
    10	  // and before every commit here — this is not a substitute for it.
    11	  transform: {
    12	    // tsconfig.json extends expo/tsconfig.base (module: "preserve", allowJs: true)
    13	    // for Metro's bundler. Two overrides needed only for ts-jest's own transform,
    14	    // the app's real tsconfig is untouched: (1) module: "preserve" isn't runnable
    15	    // CommonJS, which Jest needs; (2) allowJs makes ts-jest default outDir to an
    16	    // internal constant, and TS 6 hard-errors (TS5011) on outDir without an
    17	    // explicit rootDir — set rootDir to the project root to satisfy that.
    18	    '^.+\\.tsx?$': ['ts-jest', { tsconfig: { module: 'commonjs', rootDir: '.', isolatedModules: true } }],
    19	  },
    20	  // Binary media assets (require('*.wav'/'*.m4a')) can't load as JS modules under
    21	  // Jest — Metro handles them in the app. Stub them so audio.ts (and its pure
    22	  // event→sound mapping) is importable in tests.
    23	  moduleNameMapper: {
    24	    '\\.(wav|m4a)$': '<rootDir>/src/render/__tests__/__mocks__/assetStub.js',
    25	  },
    26	  // Long-running measurement probes are opt-in via `npm run test:probe -- <path>`.
    27	  // Keep the acceptance-seed audit test in the normal suite.
    28	  testPathIgnorePatterns: ['<rootDir>/src/audit/__tests__/.*-probe\\.test\\.ts$'],
    29	};
