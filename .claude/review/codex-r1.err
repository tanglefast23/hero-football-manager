   252	    .filter(round => round.fixtures.some(fixture => (
   253	      fixture.homeClubId === state.userClubId || fixture.awayClubId === state.userClubId
   254	    )))
   255	    .at(-1);
   256	  return lastRound?.label ?? 'Entered';
   257	}
