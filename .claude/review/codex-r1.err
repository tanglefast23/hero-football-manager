    67	}
    68	
    69	/** The file-system half of an import, plus the one write it is allowed to make. */
    70	export interface CareerSaveImportOptions {
    71	  /** Reads the picked file, or resolves null when the player cancelled. */
    72	  readFile: () => Promise<string | null>;
    73	  /**
    74	   * Replaces the live save. Called only after the file has fully validated, so a
    75	   * corrupt or foreign file leaves the existing career untouched.
    76	   */
    77	  replaceSave: (state: GameState) => Promise<void>;
    78	}
    79	
    80	/**
    81	 * The name the player sees in the share sheet. Season and week are in the name
    82	 * so a folder of exports is orderable without opening any of them.
    83	 */
    84	export function careerSaveFileName(state: GameState): string {
    85	  return `hero-football-manager-save-s${state.season}w${state.week}.json`;
    86	}
    87	
    88	/**
    89	 * Builds the file text for a career.
    90	 *
    91	 * The career goes through `serializeGameState`, so an export is byte-identical
    92	 * to what the live slot holds and an invalid state is refused here rather than
    93	 * becoming a file the player believes in.
    94	 */
    95	export function encodeCareerSaveFile(state: GameState): string {
    96	  const envelope: CareerSaveFileEnvelope = {
    97	    format: SAVE_FILE_FORMAT,
    98	    formatVersion: SAVE_FILE_FORMAT_VERSION,
    99	    gameSchemaVersion: GAME_SCHEMA_VERSION,
   100	    engineVersion: ENGINE_VERSION,
   101	    state: JSON.parse(serializeGameState(state)) as unknown,
   102	  };
   103	  return JSON.stringify(envelope);
   104	}
   105	
   106	/**
   107	 * Validates a file and returns the career it carries. Throws on anything else —
   108	 * nothing here writes, so every caller gets validate-before-replace for free.
   109	 */
   110	export function decodeCareerSaveFile(contents: string): DecodedCareerSaveFile {
   111	  let payload: unknown;
   112	  try {
   113	    payload = JSON.parse(contents);
   114	  } catch {
   115	    throw new InvalidSaveFileError('it is not valid JSON');
   116	  }
   117	  if (!isRecord(payload) || payload.format !== SAVE_FILE_FORMAT) {
   118	    throw new InvalidSaveFileError('it was not exported by this game');
   119	  }
   120	  if (!Number.isSafeInteger(payload.formatVersion)
   121	    || (payload.formatVersion as number) < 1) {
   122	    throw new InvalidSaveFileError('its file format version is missing or invalid');
   123	  }
   124	  // The same rule the save-migration ladder follows: an older file is read, a
   125	  // newer one is refused, because nothing here can invent the meaning of a field
   180	 */
   181	export async function exportRawCareerSave(
   182	  options: RawCareerSaveExportOptions,
   183	): Promise<CareerSaveExportResult> {
   184	  const fileName = `hero-football-manager-raw-schema-${options.raw.schemaVersion}.json`;
   185	  const uri = await options.writeFile(fileName, options.raw.stateJson);
   186	  if (options.shareFile === undefined) return { fileName, uri, shared: false };
   187	  await options.shareFile(uri);
   188	  return { fileName, uri, shared: true };
   189	}
   190	
   191	/**
   192	 * Replaces the live save with the career in a file the player picked, or returns
   193	 * null when they cancelled. The file is decoded and fully validated before
   194	 * `replaceSave` is reached, so a corrupt, foreign or future file throws with the
   195	 * existing career still in place.
   196	 *
   197	 * WIRING CONTRACT (unwired as of 2026-07-26 — read before adding the store
   198	 * action): schema validation here is NOT the whole load path. The store must
   199	 * treat the returned state exactly like `initializePersistence` treats a
   200	 * loaded row, and like a career replacement:
   201	 *   1. run it through `reconcileLoadedCareer` (roster reconcile + the
   202	 *      retired-content fail-softs) before `set({ career })`,
   203	 *   2. resume via `resumeScreen`, and
   204	 *   3. clean up the replaced career like `startNewCareer` does — delete the
   205	 *      old career's replays; the seed-keyed backup then refreshes on the
   206	 *      first save.
   207	 * Skipping step 1 installs a save the ordinary load path would have repaired,
   208	 * which can throw on every relaunch.
   209	 */
   210	export async function importCareerSave(
   211	  options: CareerSaveImportOptions,
   212	): Promise<GameState | null> {
   213	  const contents = await options.readFile();
