{
  "name": "hero-football-manager-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron shell that serves the Hero Football Manager web export for Steam.",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "check": "electron check.mjs",
    "pack": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tanglefast.herofootballmanager",
    "productName": "Hero Football Manager",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.mjs",
      "shell.mjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app"
      }
    ],
    "icon": "../assets/icon.png",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
